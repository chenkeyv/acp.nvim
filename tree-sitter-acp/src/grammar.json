{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "acp",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "blank_line"
          },
          {
            "type": "SYMBOL",
            "name": "fenced_code_block"
          },
          {
            "type": "SYMBOL",
            "name": "command_action"
          },
          {
            "type": "SYMBOL",
            "name": "tool_action"
          },
          {
            "type": "SYMBOL",
            "name": "exploration_action"
          },
          {
            "type": "SYMBOL",
            "name": "user_header"
          },
          {
            "type": "SYMBOL",
            "name": "agent_header"
          },
          {
            "type": "SYMBOL",
            "name": "plan_header"
          },
          {
            "type": "SYMBOL",
            "name": "review_header"
          },
          {
            "type": "SYMBOL",
            "name": "text_line"
          }
        ]
      }
    },
    "blank_line": {
      "type": "SYMBOL",
      "name": "_newline"
    },
    "user_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(U|) You[^\\r\\n]*\\r?\\n"
        }
      }
    },
    "agent_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(A|󰚩) Codex[^\\r\\n]*\\r?\\n"
        }
      }
    },
    "plan_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(#|) Plan[^\\r\\n]*\\r?\\n"
        }
      }
    },
    "review_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(#|) Review[^\\r\\n]*\\r?\\n"
        }
      }
    },
    "command_action": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "state",
          "content": {
            "type": "SYMBOL",
            "name": "command_marker"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": " "
                },
                {
                  "type": "FIELD",
                  "name": "subject",
                  "content": {
                    "type": "SYMBOL",
                    "name": "command_subject"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "command_continuation"
              },
              {
                "type": "SYMBOL",
                "name": "action_result"
              },
              {
                "type": "SYMBOL",
                "name": "action_result_continuation"
              }
            ]
          }
        }
      ]
    },
    "tool_action": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "state",
          "content": {
            "type": "SYMBOL",
            "name": "tool_marker"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": " "
                },
                {
                  "type": "FIELD",
                  "name": "subject",
                  "content": {
                    "type": "SYMBOL",
                    "name": "tool_subject"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "action_result"
              },
              {
                "type": "SYMBOL",
                "name": "action_result_continuation"
              }
            ]
          }
        }
      ]
    },
    "exploration_action": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "state",
          "content": {
            "type": "SYMBOL",
            "name": "exploration_marker"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "exploration_result"
              },
              {
                "type": "SYMBOL",
                "name": "exploration_continuation"
              }
            ]
          }
        }
      ]
    },
    "command_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "• (You ran|Running|Ran)"
        }
      }
    },
    "tool_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "• (Calling|Called)"
        }
      }
    },
    "exploration_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "• (Exploring|Explored)"
        }
      }
    },
    "command_subject": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "tool_subject": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "command_continuation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_pipe"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "command_detail"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "action_result": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_branch"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "result_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "action_result_continuation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_indent"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "result_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "exploration_result": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_branch"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "exploration_detail"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "exploration_continuation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "action_indent"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "exploration_detail"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "action_pipe": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "STRING",
          "value": "  │ "
        }
      }
    },
    "action_branch": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "STRING",
          "value": "  └ "
        }
      }
    },
    "action_indent": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "STRING",
          "value": "    "
        }
      }
    },
    "command_detail": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "result_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "exploration_detail": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "fenced_code_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "fence_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "code_fence_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "fence_end"
        }
      ]
    },
    "fence_start": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "delimiter",
          "content": {
            "type": "SYMBOL",
            "name": "fence_delimiter"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "language",
              "content": {
                "type": "SYMBOL",
                "name": "language"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "fence_padding"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "fence_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "delimiter",
          "content": {
            "type": "SYMBOL",
            "name": "fence_delimiter"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "fence_padding"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "fence_delimiter": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "`{3,}"
        }
      }
    },
    "language": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[A-Za-z0-9_+.-]+"
        }
      }
    },
    "fence_padding": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]+"
      }
    },
    "code_fence_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "code_line"
      }
    },
    "code_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": -2,
            "content": {
              "type": "PATTERN",
              "value": "[^\\r\\n]*\\r?\\n"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": -2,
            "content": {
              "type": "PATTERN",
              "value": "[^\\r\\n]+"
            }
          }
        }
      ]
    },
    "text_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -3,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}